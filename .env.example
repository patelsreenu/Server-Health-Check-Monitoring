# Copy to .env and fill in. Never commit .env.

# ── Web server ─────────────────────────────────────────────
PORT=3001                     # HTTPS port
HTTP_PORT=3180                # redirects to HTTPS
# PUBLIC_HOSTNAME=monitor.corp.example.com
# TLS certificate (otherwise a self-signed one is generated at start-up)
# TLS_PFX_PATH=C:\certs\healthmonitor.pfx
# TLS_PFX_PASSPHRASE=
# TLS_CERT_PATH=/etc/ssl/healthmonitor.crt
# TLS_KEY_PATH=/etc/ssl/healthmonitor.key
# HOST_SERVER_ID=             # id (in servers.json) of the server running this app; adds a warning before stopping it

# ── Credentials used to collect health data (read-only accounts are enough) ──
WINRM_USERNAME=CORP\svc-healthmonitor
WINRM_PASSWORD=
SSH_USERNAME=svc-healthmonitor
SSH_PASSWORD=

# ── Active Directory (checks admin credentials before an action) ──
LDAP_SERVICE_PASSWORD=

# ── Cloud (optional; can also be set in server/config/clouds.json) ──
# AWS_SSO_START_URL=https://d-xxxxxxxxxx.awsapps.com/start
# AWS_ACCOUNT_ID=
# AWS_REGION=us-east-1
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
# OCI_CONFIG_FILE=
# OCI_COMPARTMENT_ID=

# ── Email alerts ───────────────────────────────────────────
SMTP_HOST=                    # unset = alerts are evaluated and logged only
SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
ALERT_TO=ops-team@example.com
ALERT_FROM=Health Monitor <health-monitor@example.com>
ALERT_REMIND_HOURS=12
ALERT_SEND_RESOLVED=false
# ALERT_DRY_RUN=true          # log emails instead of sending them
# ALERT_STRIP_DOMAIN=corp.example.com   # show short host names in the dashboard and emails
# SERVICE_RESTART_NOTIFY=true
# ENDPOINT_SEND_RECOVERY=true

# ── Network and firewall tabs (optional; each tab is hidden until set) ──
# NETOPS_URL=https://netops.corp.example.com:3007
# PANOS_PORTAL_URL=https://fw-portal.corp.example.com:3000
# NETWORK_INSECURE_TLS=false  # accept self-signed certificates from those tools (default: localhost only)

# ── History ────────────────────────────────────────────────
# HISTORY_DIR=server/data
# HISTORY_RETENTION_DAYS=30

# ── AI (optional; any provider with an HTTPS API) ──────────
# AI_API_URL=https://api.example-ai.com/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=
# AI_API_FORMAT=chat          # chat (OpenAI-style) or messages
# AI_API_KEY_HEADER=          # custom header for the key, e.g. api-key
# AI_API_HEADERS={}           # extra headers as JSON
# AI_HOURLY_BUDGET=30
# AI_CACHE_MINUTES=15
# AI_REDACT_HOSTNAMES=true    # hide host names from the AI provider
# AI_AUTO_TICKETS=off         # off | dry-run | on
